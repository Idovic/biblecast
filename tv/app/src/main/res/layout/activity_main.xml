<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran de l'APK Android TV BibleCast
  Deux états :
    - #waiting_layout : écran d'attente animé (tablette non détectée)
    - #webview_layout : WebView plein écran (tablette connectée)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ════════════════════════════════════════════════════════════
         ÉCRAN D'ATTENTE — tablette non détectée
         ════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waiting_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:visibility="visible">

        <!-- Overlay sombre léger pour lisibilité -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#33000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Conteneur central (logo + titre + sous-titre + spinner) -->
        <LinearLayout
            android:id="@+id/center_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Logo de l'app -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="BibleCast Logo" />

            <!-- Nom de l'app -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="BibleCast"
                android:textColor="@color/white"
                android:textSize="52sp"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8" />

            <!-- Sous-titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Écran de diffusion"
                android:textColor="@color/text_dim"
                android:textSize="20sp"
                android:letterSpacing="0.12" />

            <!-- Séparateur doré -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/gold_accent" />

            <!-- Spinner + message d'état -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:indeterminateTint="@color/gold_accent" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recherche de la tablette en cours…"
                    android:textColor="@color/gold_accent"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Message d'aide — bas de l'écran -->
        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="Assurez-vous que l'application BibleCast est lancée sur la tablette\net que la tablette est connectée au même réseau WiFi"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ════════════════════════════════════════════════════════════
         WEBVIEW — contenu de la tablette (Display.tsx)
         ════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/webview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:visibility="gone">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Lecteur vidéo natif : invisible (alpha 0) jusqu'à sa première image,
             puis fondu par-dessus la page. Jamais d'écran noir ni d'icône. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@android:color/black"
            android:focusable="false"
            app:use_controller="false"
            app:surface_type="texture_view"
            app:resize_mode="fit"
            app:shutter_background_color="@android:color/transparent" />

    </FrameLayout>

</FrameLayout>
